# =============================================================
#  fAIshon — Environment Variables
#  Copy this file to .env and fill in your actual credentials.
#  NEVER commit the real .env file to version control.
# =============================================================

# ---- Django Settings ----
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-ec2-ip,your-domain.com
CSRF_TRUSTED_ORIGINS=http://your-ec2-ip,http://your-domain.com

# ---- Cloudinary (media / image storage) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Groq API (LLM for upcycle idea & instruction generation) ----
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Database (PostgreSQL or SQLite) ----
# Set USE_SQLITE=True to run with local SQLite (ideal for free tier / simple servers)
USE_SQLITE=False
PG_DB_NAME=faishon_db
PG_DB_USER=postgres
PG_DB_PASSWORD=postgres123
PG_DB_HOST=localhost
PG_DB_PORT=5432
